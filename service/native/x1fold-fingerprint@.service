[Unit]
Description=Fold native fingerprint transaction

[Service]
DynamicUser=yes
User=x1fold-native
StandardInput=socket
StandardOutput=null
StandardError=journal
ExecStart=/usr/local/libexec/x1fold-fingerprint/native-worker
LoadCredentialEncrypted=x1fold-native.sensor.cert
LoadCredentialEncrypted=x1fold-native.host.cert
LoadCredentialEncrypted=x1fold-native.host-key.pem
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
LimitCORE=0
RuntimeMaxSec=130s
TimeoutStopSec=3s
